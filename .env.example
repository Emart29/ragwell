# ===========================================
# RAGWELL Environment Configuration
# ===========================================
# Copy this file to .env and fill in your API keys

# -------------------------------------------
# Jina AI (Required for embeddings + reranking)
# Get your free API key at: https://jina.ai/embeddings/
# Free tier: 10M tokens/month
# -------------------------------------------
JINA_API_KEY=jina_your_api_key_here

# -------------------------------------------
# Groq (Optional: second provider, and HyDE/Query Expansion)
# Get your free API key at: https://console.groq.com/
# Free tier: Generous rate limits available
# -------------------------------------------
GROQ_API_KEY=gsk_your_api_key_here

# -------------------------------------------
# Google Gemini (Required for answering)
# Every published number in the README was measured on this provider.
# Get your API key at: https://aistudio.google.com/apikey
# -------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# -------------------------------------------
# Application Settings (Optional)
# -------------------------------------------
# LOG_LEVEL=INFO
# MAX_FILE_SIZE_MB=10
# MAX_CHUNKS_PER_BATCH=50
